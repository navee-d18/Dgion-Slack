rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper: Verify if user's UID is listed inside the workspace members array
    function isMemberOfWorkspace(workspaceId) {
      return isSignedIn() && 
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
    }

    // Helper: Check if user is the workspace creator
    function isWorkspaceCreator(workspaceId) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdBy == request.auth.uid;
    }

    // 1. Users Collection Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // 2. Workspaces Collection Rules
    match /workspaces/{workspaceId} {
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if isSignedIn(); 
      allow update: if isSignedIn() && (
        // Option A: Workspace creator/owner has full update permissions
        resource.data.createdBy == request.auth.uid
        // Option B: A user is self-joining (only adding their own UID to the members array)
        || (
          request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.name == resource.data.name
          && request.resource.data.iconText == resource.data.iconText
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
        )
      );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // 3. Channels Collection Rules
    match /channels/{channelId} {
      allow create: if isSignedIn() && isWorkspaceCreator(request.resource.data.workspaceId);
      allow read: if isSignedIn() && isMemberOfWorkspace(resource.data.workspaceId);
      allow update, delete: if isSignedIn() && isWorkspaceCreator(resource.data.workspaceId);
    }

    // 4. Messages Collection Rules
    match /messages/{messageId} {
      allow read: if isSignedIn() && isMemberOfWorkspace(resource.data.workspaceId);
      allow create: if isSignedIn() && isMemberOfWorkspace(request.resource.data.workspaceId);
      allow update: if isSignedIn() && (
        // Sender of the message can edit/delete their own message
        (resource.data.senderId == request.auth.uid && isMemberOfWorkspace(resource.data.workspaceId))
        // Or the workspace creator can edit/delete any message inside the workspace
        || isWorkspaceCreator(resource.data.workspaceId)
        // OR any workspace member can update ONLY the deletedFor field (for "Delete for me")
        || (
          isMemberOfWorkspace(resource.data.workspaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
        )
      );
      allow delete: if isSignedIn() && (
        (resource.data.senderId == request.auth.uid && isMemberOfWorkspace(resource.data.workspaceId))
        || isWorkspaceCreator(resource.data.workspaceId)
      );
    }

    // 5. Notifications Collection Rules
    match /notifications/{notificationId} {
      allow create: if isSignedIn() && isMemberOfWorkspace(request.resource.data.workspaceId);
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 6. Typing Status Collection Rules
    match /typing_status/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // 7. Recording Status Collection Rules
    match /recording_status/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // 8. Scheduled Messages Rules
    match /scheduled_messages/{msgId} {
      allow read: if isSignedIn() && isMemberOfWorkspace(resource.data.workspaceId);
      allow create: if isSignedIn() && isMemberOfWorkspace(request.resource.data.workspaceId) && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid
        || isWorkspaceCreator(resource.data.workspaceId)
      );
    }

    // 9. Reminders Rules
    match /reminders/{reminderId} {
      allow read: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if isSignedIn() && isMemberOfWorkspace(request.resource.data.workspaceId) && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
